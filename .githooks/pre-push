#!/bin/sh
#
# A push to `main` is a production deploy: Vercel's Git integration builds and
# ships whatever lands there, and it does not read the CI result first. Four
# pushes in a row once shipped on a red CI run for exactly that reason. So the
# gate has to hold here, before the push, not after it.
#
# Skip with `git push --no-verify` when you know why you are skipping it.

set -e

if [ "$SKIP_VERIFY" = "1" ]; then
  echo "pre-push: SKIP_VERIFY=1, skipping the gate."
  exit 0
fi

remote_main=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/main) remote_main=1 ;;
  esac
done

if [ "$remote_main" -eq 0 ]; then
  exit 0
fi

echo "pre-push: pushing main deploys to production, running npm run verify..."
npm run verify
