{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.headpin.app"
        }
      ],
      "destination": "https://headpin.app/$1",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/.well-known/(apple-app-site-association|assetlinks.json)",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    },
    {
      "source": "/catalog/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/catalog/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/catalog/sheets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/score",
      "destination": "/score/index.html"
    },
    {
      "source": "/app",
      "destination": "/score/index.html"
    },
    {
      "source": "/legal",
      "destination": "/legal/index.html"
    },
    {
      "source": "/guides/:id",
      "destination": "/guides/:id/index.html"
    }
  ]
}
