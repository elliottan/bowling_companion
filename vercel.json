{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.headpin.app" }],
      "destination": "https://headpin.app/$1",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/score",
      "destination": "/score/index.html"
    }
  ]
}
