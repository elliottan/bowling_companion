<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Universal links (ADR-159): a headpin.app link opens in the app when it is
  installed. headpin.app vouches for the app in
  public/.well-known/apple-app-site-association.

  Signed in only on Release builds: a personal (free) development team cannot
  sign Associated Domains, so a Debug build for the simulator leaves it out and
  keeps building for anyone without the paid Developer Program.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:headpin.app</string>
	</array>
</dict>
</plist>
