<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Universal links (ADR-159): a headpin.app link opens in the app when it is
  installed. headpin.app vouches for the app in
  public/.well-known/apple-app-site-association.

  Signed into Debug and Release builds alike (ADR-213), so a build run from
  Xcode on a phone opens links as the App Store build does. It needs the paid
  Developer Program's team; a personal (free) team cannot sign it.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:headpin.app</string>
	</array>
</dict>
</plist>
